> ## using more than one offset failed in R 2.8.1
> 
> 
> ## Using variable a name starting with "(weights)" :
> anoD <- within(anorexia, `(weights)_2` <- Prewt)
> fit5 <- lm(Postwt ~ `(weights)_2` + Treat + offset(o1) + offset(o2), data = anoD)
> summary(fit5)

