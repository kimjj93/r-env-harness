.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
renv/library/
renv/staging/
# Nix build symlinks (anchored to the repo root so they cannot swallow files
# elsewhere -- an unanchored `result-*` was silently excluding the committed
# baseline validation/fixtures/.../result-checksums.rds, which would have
# disabled Layer 4 of the delta with no visible error).
/result
/result-*
/artifacts/
*.html
!validation/report/*.html
.DS_Store

# Local build scratch
.harness-probe

# Scratch copied out of a container for inspection. The risk-scan work pulled
# the image's R library onto the runner with `docker cp`; a stray `git add -A`
# then committed 97 files of MASS and stats package internals to the repo root.
# Extraction targets belong here, not in a commit.
/*-tests/
/.image-lib/
